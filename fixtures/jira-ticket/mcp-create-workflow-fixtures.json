{
  "contract": "jira-ticket-mcp-backed-create-workflow-v1",
  "runtime_adapters": ["codex", "claude"],
  "required_report_fields": ["search_attempted", "search_result", "duplicate_status", "approval_status", "create_attempted", "create_call_count", "mutation_status", "automatic_retry", "actual_issue_key", "actual_issue_url", "verification_status", "allowed_next_step"],
  "scenarios": [
    { "id": "mcp-unavailable", "capabilities": { "jira.search": { "available": false, "connection_verified": false }, "jira.create": { "available": false, "connection_verified": false } }, "search": { "status": "none" }, "approval": "explicit_current_preview", "expected": { "search_attempted": false, "search_result": "not_performed", "duplicate_status": "not_checked", "approval_status": "not_requested", "create_attempted": false, "create_call_count": 0, "mutation_status": "0", "actual_issue_key": null, "actual_issue_url": null, "verification_status": "not_verifiable", "allowed_next_step": "Connect Jira MCP/Plugin or review the Ticket Contract manually" } },
    { "id": "search-only", "capabilities": { "jira.search": { "available": true, "connection_verified": true }, "jira.create": { "available": false, "connection_verified": false } }, "search": { "status": "none" }, "approval": "explicit_current_preview", "expected": { "search_attempted": true, "search_result": "none", "duplicate_status": "none", "approval_status": "not_requested", "create_attempted": false, "create_call_count": 0, "mutation_status": "0", "actual_issue_key": null, "actual_issue_url": null, "verification_status": "not_verifiable", "allowed_next_step": "Connect Jira Create capability before approving a Create Preview" } },
